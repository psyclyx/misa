diff --git a/tests/subscriptions.fnl b/tests/subscriptions.fnl
index 78f72de..e2e533f 100644
--- a/tests/subscriptions.fnl
+++ b/tests/subscriptions.fnl
@@ -35,6 +35,24 @@
 (assert (<= (scope.size) 8))
 (scope.clear)
 (assert (= (scope.size) 0))
+(var hint :unset)
+(registry.register {:id :incremental :inputs (fn [] [[:path :a]])
+                    :compute (fn [inputs _ previous]
+                               (set hint previous)
+                               {:value (. inputs 1)})})
+(local initial (scope.query {:a 1} [:incremental]))
+(assert (= hint nil) "cold compute received prior output")
+(local updated (scope.query {:a 2} [:incremental]))
+(assert (= hint initial) "incremental compute did not receive immutable prior output")
+(assert (= initial.value 1) "prior output changed")
+(local branch (scope.fork))
+(branch.query {:a 3} [:incremental])
+(assert (= hint updated) "fork did not inherit prior output")
+(branch.close)
+(assert (= updated (scope.query {:a 2} [:incremental])) "branch changed committed output")
+(scope.clear)
+(assert (= (. (scope.query {:a 2} [:incremental]) :value) updated.value))
+(assert (= hint nil) "cleared scope retained incremental hint")
 (assert (= (registry.key [:path {:x 1 :y false}]) (registry.key [:path {:y false :x 1}])))
 (assert (not= (registry.key [:path "a\31string\31b"]) (registry.key [:path :a :b])))
 (assert (not= (registry.key [:path {:x 1}]) (registry.key [:path {:y 1}])))
