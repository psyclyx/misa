;; Attribute the real picker transaction and default UI projection in LuaJIT.
;; This is diagnostic CPU sampling, not native end-to-end latency.
(local fennel (require :fennel))
(local profiler (require :jit.profile))
(local output print)
(local count (tonumber (or (. arg 1) "1000")))
(local source (assert (io.open :config/default.json :r)))
(local config-source (source:read :*a))
(source:close)
(fennel.dofile :src/lua_runtime/framework.fnl)
(local misa _G.misa)
(misa._setup (fennel.dofile :extensions/json.fnl) {})
(local config (misa.json.decode config-source))
(set config.config.benchmark {:models count})
(set config.config.models.default :bench/model-00001)
(each [_ name (ipairs [:history :themes :components :preferences])]
  (when (not (. config.config name)) (tset config.config name {}))
  (tset (. config.config name) :persist false))
(local context {:argv [] :config config.config})
(misa._setup (fennel.dofile :benchmarks/picker-key-repeat.fnl) context)
(each [_ name (ipairs config.extensions)]
  (when (and (not= name :json) (not= name :auth)
              (not (name:match "^provider%.")) (not (name:match "^protocol%.")))
    (misa._setup (fennel.dofile (.. :extensions/ (name:gsub "%." "/") :.fnl)) context)))
(misa._seal context)
(local terminal {:columns 100 :lines 32 :interactive true :images false})
(local clock {:wall_ms 0 :monotonic_ms 0})
(fn dispatch [event]
  (local queue [event])
  (var index 1)
  (while (<= index (length queue))
    (local effects (misa._dispatch (. queue index) terminal clock))
    (misa._commit)
    (each [_ effect (ipairs effects)]
      (when (= effect.type :dispatch) (table.insert queue effect.event)))
    (set index (+ index 1))))
(dispatch {:type :app/start})
(for [_ 1 6] (dispatch {:type :terminal/input :kind :arrow_down}))
(local samples {})
(profiler.start "fi1" (fn [thread count state]
                        (local key (.. state " " (profiler.dumpstack thread "pfZ < " 10)))
                        (tset samples key (+ (or (. samples key) 0) count))))
(for [_ 1 240] (dispatch {:type :terminal/input :kind :arrow_down}))
(profiler.stop)
(local rows (icollect [key count (pairs samples)] {: key : count}))
(table.sort rows (fn [a b] (> a.count b.count)))
(output (.. "Samples: " (accumulate [sum 0 _ row (ipairs rows)] (+ sum row.count))))
(each [_ row (ipairs rows)] (output row.count row.key))
