{
  "extensions": [
    "json",
    "protocol.anthropic",
    "provider.anthropic",
    "provider.kimi",
    "protocol.openai",
    "provider.openai",
    "provider.openrouter",
    "provider.openai-codex",
    "provider.claude",
    "auth",
    "tool.files",
    "tool.shell",
    "fuzzy",
    "keybindings",
    "dialogs",
    "choices",
    "preferences",
    "themes",
    "theme.default",
    "animations",
    "animation.default",
    "components",
    "layout",
    "markdown",
    "component.markdown",
    "indicators",
    "component.message",
    "component.editor",
    "component.picker",
    "component.status",
    "component.chrome",
    "component.dialog",
    "dialog_view",
    "messages",
    "status",
    "picker",
    "picker_view",
    "models",
    "request_options",
    "effort",
    "agent",
    "editor",
    "ui"
  ],
  "config": {
    "models": { "default": "claude/claude-sonnet-5" },
    "choices": {
      "purposes": {
        "command-completion": ["slash-prefix"],
        "command": ["favorites", "frecency", "all"],
        "models": ["favorites", "frecency", "all"],
        "auth": ["all"]
      }
    },
    "keybindings": {
      "global": {
        "toggle_verbose": ["alt+t"],
        "transcript_up": ["page_up", "alt+k"],
        "transcript_down": ["page_down", "alt+j"],
        "cycle_effort": ["alt+e"]
      },
      "choices": {
        "accept": ["enter", "tab"],
        "cancel": ["escape", "ctrl_c", "ctrl_d", "eof"],
        "previous": ["arrow_up"],
        "next": ["arrow_down"],
        "cycle": ["arrow_right"],
        "cycle_previous": ["arrow_left", "alt+p"],
        "favorite": ["alt+v"],
        "replace_view": ["alt+/"],
        "open_overlay": ["alt+space"]
      }
    },
    "components": {
      "roles": {
        "root.header": "default.root.header",
        "editor.input": "default.editor.input",
        "editor.completions": "default.editor.completions",
        "status.metrics": "default.status.metrics",
        "status.indicators": "default.status.indicators",
        "picker": "default.picker",
        "dialog": "default.dialog",
        "transcript.user": "default.transcript.user",
        "transcript.assistant": "default.transcript.assistant",
        "transcript.thinking": "default.transcript.thinking",
        "transcript.thinking_collapsed": "default.transcript.thinking_collapsed",
        "transcript.tool_call": "default.transcript.tool_call",
        "transcript.tool_result": "default.transcript.tool_result",
        "transcript.harness": "default.transcript.harness"
      }
    },
    "themes": { "default": "default", "persist": true },
    "animations": { "default": "default" },
    "markdown": { "max_source_bytes": 262144, "max_blocks": 4096, "max_inlines": 16384, "max_inline_depth": 12, "max_link_bytes": 4096 },
    "messages": { "verbose": false, "markdown": true, "max_string": 4000, "max_items": 64, "max_depth": 8 },
    "status": {
      "indicators": [
        { "id": "activity", "representation": "icon", "priority": 100 },
        { "id": "model", "representation": "label", "priority": 90 },
        { "id": "effort", "representation": "label", "hotkey": true, "priority": 70 },
        { "id": "session", "representation": "icon", "priority": 40 },
        { "id": "context", "representation": "label", "priority": 80 },
        { "id": "transcript-detail", "representation": "label", "hotkey": true, "priority": 20 }
      ]
    },
    "ui": { "plain_prompt": true }
  }
}
